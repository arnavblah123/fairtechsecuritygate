# Backend (Vercel project environment variables; also usable in a local .env for `vercel dev`)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=fairtech-gate-photos
S3_ACCESS_KEY_ID=your-b2-keyID
S3_SECRET_ACCESS_KEY=your-b2-applicationKey
