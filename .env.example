# Vercel project environment variables for THIS app only (Settings -> Environment Variables).
# All names start with GATE_ so they never clash with shared variables of your other apps.
GATE_DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
GATE_JWT_SECRET=change-me-to-a-long-random-string
# Optional: read-only link to the production app's database. Labourers are mirrored from its Employee table
# (name, code, skill, unit, active) every hour and on demand from Admin -> Labourers -> "Sync from production now".
GATE_PRODUCTION_DATABASE_URL=postgresql://user:password@ep-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# BLOB_READ_WRITE_TOKEN is added automatically when you connect a Vercel Blob store to the project.
